<Window x:Class="Hourglass.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hourglass.Views"
        xmlns:converters="clr-namespace:Hourglass.Converters"
        Style="{StaticResource AppWindow}"
        Title="Вход в Steam"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border Padding="24">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Вход в Steam" Style="{StaticResource TitleText}" />
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,0,0,20"
                       Text="Пароль нужен один раз и никуда не записывается. Программа сохранит только токен Steam, зашифрованный ключом вашей учётной записи Windows." />

            <!-- Step: credentials -->
            <StackPanel Visibility="{Binding IsCredentialsStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="ЛОГИН" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6" />
                <TextBox x:Name="UsernameInput"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding IsUsernameLocked}"
                         Tag="Логин Steam"
                         Margin="0,0,0,14" />

                <TextBlock Text="ПАРОЛЬ" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,4" />
            </StackPanel>

            <!-- Step: waiting on Steam -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,4,0,4"
                        Visibility="{Binding IsWorkingStep, Converter={StaticResource BoolToVisibility}}">
                <views:Spinner VerticalAlignment="Center" />
                <TextBlock Text="{Binding WorkingText}"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>

            <!-- Step: Steam Guard -->
            <StackPanel Visibility="{Binding IsGuardStep, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource InsetCard}" Padding="14" Margin="0,0,0,14">
                    <TextBlock Text="{Binding GuardHint}"
                               Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                </Border>

                <!-- Mobile approval or manual code -->
                <StackPanel Visibility="{Binding IsChoicePrompt, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Готово — я подтвердил на телефоне"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmedInAppCommand}"
                            Margin="0,0,0,8" />
                    <Button Content="Запроса нет — ввести код из приложения"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding UseCodeInsteadCommand}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsCodePrompt, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="КОД STEAM GUARD" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6" />
                    <TextBox x:Name="GuardCodeInput"
                             Text="{Binding GuardCode, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Например, K4X9P"
                             CharacterCasing="Upper"
                             MaxLength="10"
                             FontSize="16"
                             Margin="0,0,0,12" />
                    <Button Content="Подтвердить"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SubmitGuardCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Error -->
            <Border Background="{StaticResource DangerSoftBrush}"
                    Padding="12,8"
                    CornerRadius="6"
                    Margin="0,12,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Footer -->
            <Grid Margin="0,20,0,0">
                <Button Content="Отмена"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        Command="{Binding CancelCommand}"
                        IsCancel="True" />
                <Button x:Name="SignInButton"
                        Content="Войти"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        MinWidth="110"
                        Click="OnSignInClick"
                        Visibility="{Binding IsCredentialsStep, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

        </StackPanel>
    </Border>
</Window>
