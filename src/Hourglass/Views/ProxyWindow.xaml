<Window x:Class="Hourglass.Views.ProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Hourglass.Converters"
        Style="{StaticResource AppWindow}"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Через что выходить в Steam" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,6,0,16"
                       Text="Этот аккаунт будет подключаться к Steam через указанный адрес — и вход, и накрутка. Пустое поле означает, что он идёт напрямую, как и всё остальное на компьютере." />

            <TextBlock Text="АДРЕС ПРОКСИ" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Tag="host:port или socks5://user:pass@host:port"
                         Text="{Binding ProxyText, UpdateSourceTrigger=LostFocus}" />

                <Button Grid.Column="1"
                        Content="Проверить"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding TestProxyCommand}"
                        Margin="8,0,0,0" />
            </Grid>

            <TextBlock Style="{StaticResource MetricText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,8,0,0"
                       Text="Подходят http, https, socks4, socks4a и socks5. Логин и пароль пишутся прямо в адресе и хранятся так же, как вход в Steam — зашифрованными для этого компьютера." />

            <TextBlock Text="{Binding ProxyStatus}"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasProxyStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Setter Property="TextTrimming" Value="None" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProxyStatusBad}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="Закрыть"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Margin="0,20,0,0"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Border>
</Window>
