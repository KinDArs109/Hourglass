<Window x:Class="Hourglass.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Hourglass.Converters"
        Style="{StaticResource AppWindow}"
        Width="720" Height="560"
        MinWidth="520" MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <converters:LogLevelToBrushConverter x:Key="LevelToBrush" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Журнал" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding DisplayName}"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource InsetCard}" Padding="6">
            <Grid>
                <TextBlock Text="Событий пока нет"
                           Style="{StaticResource MetricText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasLogEntries, Converter={StaticResource InverseBoolToVisibility}}" />

                <ListBox ItemsSource="{Binding Log}"
                         ItemContainerStyle="{StaticResource PlainListItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           FontSize="12"
                                           Margin="12,0,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Style="{StaticResource MetricText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       Text="Полная история пишется в %APPDATA%\Hourglass\hourglass.log" />
            <Button Content="Закрыть"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
