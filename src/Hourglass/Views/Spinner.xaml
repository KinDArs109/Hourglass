<UserControl x:Class="Hourglass.Views.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="24" Height="24"
             IsHitTestVisible="False"
             Focusable="False">
    <Grid Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <RotateTransform x:Name="Rotation" />
        </Grid.RenderTransform>
        <Ellipse Width="22" Height="22"
                 Stroke="{StaticResource BorderStrongBrush}"
                 StrokeThickness="2.5" />
        <Path Data="M 12,1 A 11,11 0 0 1 23,12"
              Stretch="None"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Stroke="{StaticResource AccentBrush}"
              StrokeThickness="2.5"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" />
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="Rotation"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:0.9" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</UserControl>
