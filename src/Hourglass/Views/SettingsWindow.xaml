<Window x:Class="Hourglass.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hourglass.Views"
        xmlns:converters="clr-namespace:Hourglass.Converters"
        Style="{StaticResource AppWindow}"
        Title="Настройки"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Управление с телефона" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,6,0,18"
                       Text="Бот в Telegram показывает статус, запускает и останавливает накрутку и предупреждает, когда аккаунту нужен ваш вход." />

            <Border Style="{StaticResource InsetCard}" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource MetricText}" TextWrapping="Wrap" TextTrimming="None">
                        <Run Text="1." FontWeight="SemiBold" />
                        <Run Text="В Telegram напишите @BotFather, отправьте /newbot и заберите токен." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MetricText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0">
                        <Run Text="2." FontWeight="SemiBold" />
                        <Run Text="Вставьте токен сюда и нажмите «Проверить и включить»." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource MetricText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0">
                        <Run Text="3." FontWeight="SemiBold" />
                        <Run Text="Напишите своему боту команду привязки — она появится ниже." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="ТОКЕН БОТА" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                         Tag="123456789:AA..." />
                <Button Grid.Column="1"
                        Content="Проверить и включить"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveTokenCommand}"
                        Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="ПРОКСИ ДЛЯ БОТА (ЕСЛИ TELEGRAM НЕ ОТКРЫВАЕТСЯ)"
                       Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6" />
            <TextBox Text="{Binding BotProxy, UpdateSourceTrigger=LostFocus}"
                     Tag="host:port или socks5://user:pass@host:port"
                     Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource MetricText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,0,0,14"
                       Text="Касается только бота — накрутка Steam ходит своим путём. Пусто, если Telegram открывается и так. После сохранения нажмите «Проверить и включить»: ответ придёт уже через прокси." />

            <Border Style="{StaticResource InsetCard}" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding PairingInstruction}"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="13" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Проверить связь"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SendTestCommand}" />
                        <Button Content="Отвязать чат"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding UnpairCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <CheckBox Style="{StaticResource ToggleSwitch}"
                      Content="Бот включён"
                      IsChecked="{Binding TelegramEnabled}" />
            <CheckBox Style="{StaticResource ToggleSwitch}"
                      Content="Писать, когда аккаунту нужен вход или случилась ошибка"
                      IsChecked="{Binding NotifyProblems}" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <views:Spinner VerticalAlignment="Center" />
                <TextBlock Text="Спрашиваем Telegram…"
                           Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>

            <Border CornerRadius="6"
                    Padding="12,8"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusBad}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Setter Property="TextTrimming" Value="None" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatusBad}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Rectangle Style="{StaticResource HairLine}" Margin="0,22,0,18" />

            <TextBlock Text="Данные" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,6,0,14"
                       Text="Копия настроек забирает аккаунты, списки игр, цели и расписания. Вход в Steam в неё не попадает: Windows привязывает его к этому компьютеру." />

            <StackPanel Orientation="Horizontal">
                <Button Content="Сбросить счётчики"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetCountersCommand}"
                        ToolTip="Обнулить накрученные часы у всех аккаунтов, игр и в истории." />
                <Button Content="Сохранить копию"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ExportCommand}"
                        Margin="8,0,0,0" />
                <Button Content="Восстановить из копии"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ImportCommand}"
                        Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding DataMessage}"
                       Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,10,0,0"
                       Visibility="{Binding HasDataMessage, Converter={StaticResource BoolToVisibility}}" />

            <Button Content="Закрыть"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Margin="0,20,0,0"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Border>
</Window>
