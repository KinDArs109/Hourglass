<Window x:Class="Hourglass.Views.AchievementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hourglass.Views"
        xmlns:converters="clr-namespace:Hourglass.Converters"
        Style="{StaticResource AppWindow}"
        Width="980" Height="640"
        MinWidth="760" MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Достижения" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       Margin="0,6,0,0"
                       Text="Выберите игру слева, отметьте достижения и нажмите «Применить». Steam покажет их в профиле как обычные. Аккаунт при этом должен быть запущен." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Games -->
            <Border Style="{StaticResource InsetCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                             Margin="0,0,0,8"
                             Tag="Поиск по названию"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame}"
                             ItemContainerStyle="{StaticResource AccountListItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Margin="10,7"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Achievements -->
            <Border Grid.Column="1" Style="{StaticResource InsetCard}" Padding="12" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10"
                          Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Summary}"
                                   Style="{StaticResource MetricText}"
                                   VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отметить все"
                                    Style="{StaticResource GhostButton}"
                                    Padding="10,4" MinHeight="28" FontSize="12"
                                    Command="{Binding MarkAllCommand}" />
                            <Button Content="Снять все"
                                    Style="{StaticResource GhostButton}"
                                    Padding="10,4" MinHeight="28" FontSize="12"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearAllCommand}" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Achievements}"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsUnlocked, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChange}"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Note}"
                                                   Style="{StaticResource MetricText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasAchievements, Converter={StaticResource InverseBoolToVisibility}}">
                        <views:Spinner HorizontalAlignment="Center"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Выберите игру слева"
                                   Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding Status}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       MaxWidth="560"
                       HorizontalAlignment="Left"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="TextTrimming" Value="None" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusBad}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Применить"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="130"
                        Command="{Binding ApplyCommand}" />
                <Button Content="Закрыть"
                        Style="{StaticResource GhostButton}"
                        MinWidth="110"
                        Margin="8,0,0,0"
                        IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
