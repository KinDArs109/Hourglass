<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces, from the window backdrop up to the most raised card. -->
    <Color x:Key="BackgroundColor">#FF0D1117</Color>
    <Color x:Key="SidebarColor">#FF11161E</Color>
    <Color x:Key="SurfaceColor">#FF161D27</Color>
    <Color x:Key="SurfaceAltColor">#FF1B2430</Color>
    <Color x:Key="ElevatedColor">#FF212C3A</Color>

    <Color x:Key="BorderColor">#FF25303F</Color>
    <Color x:Key="BorderStrongColor">#FF334154</Color>

    <Color x:Key="TextPrimaryColor">#FFE8EEF6</Color>
    <Color x:Key="TextSecondaryColor">#FF93A1B3</Color>
    <Color x:Key="TextMutedColor">#FF64748B</Color>

    <Color x:Key="AccentColor">#FF4C9AF5</Color>
    <Color x:Key="AccentHoverColor">#FF6BAEF8</Color>
    <Color x:Key="AccentPressedColor">#FF3B82D6</Color>
    <Color x:Key="AccentSoftColor">#284C9AF5</Color>

    <Color x:Key="SuccessColor">#FF43C463</Color>
    <Color x:Key="SuccessSoftColor">#2843C463</Color>
    <Color x:Key="WarningColor">#FFE3B341</Color>
    <Color x:Key="WarningSoftColor">#28E3B341</Color>
    <Color x:Key="DangerColor">#FFF1595B</Color>
    <Color x:Key="DangerSoftColor">#28F1595B</Color>
    <Color x:Key="SandColor">#FFF0B429</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="SandBrush" Color="{StaticResource SandColor}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>

</ResourceDictionary>
